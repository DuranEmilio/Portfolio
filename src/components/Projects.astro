---
import NextJS from "../icons/NextJS.astro";
import PostgreSQL from "../icons/PostgreSQL.astro";
import Firebase from "../icons/Firebase.astro";
import React from "../icons/React.astro";
import Link from "../icons/Link.astro";
import AstroIcon from "../icons/AstroIcon.astro";
import Wordpress from "../icons/Wordpress.astro";
import Markdown from "../icons/Markdown.astro";
import Tailwind from "../icons/Tailwind.astro";
import GitHub from "../icons/GitHub.astro";

const TAGS = {
  NextJS: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  Tailwind: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  Astro: {
    name: "Astro",
    class: "bg-white/20 text-white",
    icon: AstroIcon,
  },
  Markdown: {
    name: "Markdown",
    class: "bg-black text-white",
    icon: Markdown,
  },
  Wordpress: {
    name: "WordPress",
    class: "bg-white/80 text-black",
    icon: Wordpress,
  },
  React: {
    name: "React",
    class: "bg-[#3b3b3b] text-white",
    icon: React,
  },
  Firebase: {
    name: "Firebase",
    class: "bg-yellow-500/50 text-white",
    icon: Firebase,
  },
  PostgreSQL: {
    name: "PostgreSQL",
    class: "bg-[#20425d] text-white",
    icon: PostgreSQL,
  },
};

const PROJECTS = [
  {
    title: "Yimi PDV (coworking) - Punto de venta",
    description:
      "Aplicación web de punto de venta (POS) desarrollada con Next.js, React, PostgreSQL, Firebase y Tailwind. Permite gestionar tu negocio de manera eficiente",
    image: "/projects/Yimi-pdv.png",
    link: "https://web.yimiglobal.com",
    github: "https://github.com/XilionDev/Yimi-web-pos",
    tags: [TAGS.React, TAGS.NextJS, TAGS.Tailwind],
  },
  {
    title: "Xilion - kioscos de autoservicio",
    description:
      "Pagina infomativa de la empresa Xilion, dedicada a la venta de kioscos de autoservicio para restaurantes y comercios. Desarrollada con Astro y manejo de contenido con Markdown.",
    image: "/projects/xilion-page.webp",
    link: "https://xilion.io",
    github: "https://github.com/XilionDev/xilion-page",
    tags: [TAGS.Astro, TAGS.Markdown, TAGS.Wordpress],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ title, description, image, link, github, tags }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              src={image}
              alt={`proyecto ${image}`}
            />
          </div>
        </div>
        <div class="flex-1 max-w-[400px]">
          <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 text-pretty">
            {title}
          </h2>
          <div class="flex flex-wrap mt-2">
            <ul class="flex gap-2 flex-row mb-2 flex-wrap">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`${tag.class} flex gap-x-2 rounded-full text-xs items-center py-1 px-2`}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>
            <p class="mt-2 text-gray-700 dark:text-gray-400">{description}</p>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              <a
                href={link}
                class="inline-flex bg-gray-100 text-gray-800 border-gray-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-gray-800 border dark:border-gray-600 focus-visible:ring-yellow-500/80 text-md hover:bg-gray-800 hover:border-gray-900 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-offset-2 active:bg-black"
                target="_blank"
                rel="noopener"
              >
                <Link class="size-4" />
                Preview
              </a>
              <a
                href={github}
                class="inline-flex bg-gray-100 text-gray-800 border-gray-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-gray-800 border dark:border-gray-600 focus-visible:ring-yellow-500/80 text-md hover:bg-gray-800 hover:border-gray-900 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-offset-2 active:bg-black"
                target="_blank"
                rel="noopener"
              >
                <GitHub class="size-4" />
                Github
              </a>
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
