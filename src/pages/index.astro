---
import Badge from "../components/Badge.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SocialPill from "../components/SocialPill.astro";
import Code from "../icons/Code.astro";
import GitHub from "../icons/GitHub.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import Mail from "../icons/Mail.astro";
import SuitCase from "../icons/SuitCase.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Portafolios de Emilio - Desarrollador web, programador y analista de datos con más de 4 años de experiencia."
	description="Conocé mi portafolio, un sitio web donde muestro mis proyectos y habilidades como desarrollador web, programador y analista de datos. Con más de 4 años de experiencia, he trabajado en diversas aplicaciones únicas que resuelven problemas reales. ¡Explora mi trabajo y contáctame para colaborar!"
>
	<main class="px-4">
		<SectionContainer className="py-44 pb-22">
			<img
				class="rounded-full w-12 h-12 mb-4"
				src="https://static.vecteezy.com/system/resources/thumbnails/009/292/244/small_2x/default-avatar-icon-of-social-media-user-vector.jpg"
				alt="logo"
			/>
			<h1
				class="text-white text-3xl md:text-4xl xl:text-5xl font-bold flex flex-row gap-x-4 lg:pb-10 pb-6"
			>
				Hey, soy Emilio <a
					href="/"
					target="_blank"
					rel="noopener"
					class="flex justify-center items-center"
					><Badge>Disponible para trabajar</Badge></a
				>
			</h1>
			<h2 class="lg:text-2xl text-xl opacity-80 text-wrap max-w-[700px]">
				<span>+4 años de experiencia. </span>
				<span class="text-yellow-200"
					>Desarrollador web, programador Frontend y Backend</span
				>.
				<span class="text-red-200/90"> De Colima, Mexico</span>.
				<span class="opacity-80">
					Especializado en crear soluciones practicas y optimas para
					aplicaciones únicas</span
				>
			</h2>
			<nav class="flex gap-4 mt-8 flex-wrap">
				<SocialPill href="/">
					<LinkedIn class="size-4 md:size-6" />
					LinkedIn
				</SocialPill>
				<SocialPill href="/">
					<GitHub class="size-4 md:size-6" />
					GitHub
				</SocialPill>
				<SocialPill href="mailto:durantelleze@gmail.com">
					<Mail class="size-4 md:size-6" />
					durantelleze@gmail.com
				</SocialPill>
			</nav>
		</SectionContainer>

		<SectionContainer id="experience">
			<h2 class="text-3xl font-semibold mb-6 flex items-center gap-x-2">
				<SuitCase class="size-6" />
				Expeiencia laboral
			</h2>
			<Experience />
		</SectionContainer>

		<SectionContainer id="projects">
			<h2 class="text-3xl font-semibold mb-6 flex items-center gap-x-2">
				<Code class="size-6" />
				Proyectos
			</h2>
			<Projects />
		</SectionContainer>
	</main>
</Layout>
